# Supabase — Project Settings → API
# Copy to .env.local for local development (gitignored). CRA requires REACT_APP_ prefix.

REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-key

# Shown on /privacy and login footer (defaults if unset)
# REACT_APP_PRIVACY_CONTACT_EMAIL=privacy@yourcompany.com
